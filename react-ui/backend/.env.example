# AWS Configuration
AWS_REGION=us-east-1
# Note: For local development, configure AWS credentials via AWS CLI or environment variables
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key

# AgentCore Configuration (Required)
# Get this ARN from your deployed geo_agent (.bedrock_agentcore.yaml)
AGENT_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-east-1:YOUR_ACCOUNT_ID:runtime/YOUR_AGENT_ID
# Optional: several runtimes the UI can switch between (GET /api/agents, agentId on invoke).
# JSON object keyed by agentId; each entry needs "arn", "label" and "description" are shown in
# the picker. When set, AGENT_RUNTIME_ARN is ignored. Requests without agentId use the entry
# named "default", or the first entry when there is none.
# AGENT_RUNTIMES={"default":{"arn":"arn:aws:bedrock-agentcore:us-east-1:YOUR_ACCOUNT_ID:runtime/STABLE_ID","label":"Earth Analyst","description":"Sentinel-2 analysis, change detection, protected areas"},"dev":{"arn":"arn:aws:bedrock-agentcore:us-east-1:YOUR_ACCOUNT_ID:runtime/DEV_ID","label":"Earth Analyst (dev)","description":"Development runtime"}}

# S3 Configuration (Required)
S3_BUCKET_NAME=geospatial-agent-on-aws-YOUR_ACCOUNT_ID

# Server Configuration
PORT=3001
FRONTEND_URL=http://localhost:5173
