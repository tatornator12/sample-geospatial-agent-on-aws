# Ignore local environment files (dev-only) at EVERY level of the build context.
# A bare `.env` only matches the context root; `frontend/.env` (VITE_DEV_MODE, the local
# API base, local TiTiler values) once reached a production build this way. Production
# build inputs arrive as Docker build args from frontend-cdk, never from env files.
**/.env
**/.env.*
!**/.env.example

# Ignore node_modules (will be installed fresh in Docker)
node_modules
frontend/node_modules
backend/node_modules

# Ignore build artifacts
frontend/dist
backend/dist

# Ignore git
.git
.gitignore

# Ignore dev files
*.log
npm-debug.log*
.DS_Store
