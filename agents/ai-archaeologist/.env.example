# Copy to .env (stable runtime) and .env.dev (dev runtime). Both are gitignored.
# Same bucket and execution role as the other agents. No data token: USGS 3DEP is public, and the
# terrain is pre-built into the bucket by scripts/build_site_catalogue.py.
S3_BUCKET_NAME=geospatial-agent-on-aws-YOUR_ACCOUNT_ID
AGENTCORE_ARN=arn:aws:iam::YOUR_ACCOUNT_ID:role/agentcore-geospatial-agent-on-aws-role
AWS_REGION=us-east-1
MODEL_ID=us.anthropic.claude-sonnet-4-6
# ArcGIS Enterprise MCP (reverse_geocode only)
ARCGIS_MCP_URL=https://esri.geospatial.tfc.aws.dev/hosting/platform/mcp
ARCGIS_MCP_TOKEN=your_arcgis_mcp_token
# Optional
DISABLE_ADOT_OBSERVABILITY=true
