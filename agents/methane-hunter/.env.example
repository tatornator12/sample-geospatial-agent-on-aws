# Copy to .env (stable runtime) and .env.dev (dev runtime). Both are gitignored.
# Same bucket and execution role as the Earth Analyst are fine.
S3_BUCKET_NAME=geospatial-agent-on-aws-YOUR_ACCOUNT_ID
AGENTCORE_ARN=arn:aws:iam::YOUR_ACCOUNT_ID:role/agentcore-geospatial-agent-on-aws-role
AWS_REGION=us-east-1
MODEL_ID=us.anthropic.claude-sonnet-4-6

# ArcGIS Enterprise MCP (geocoding: find_address_candidates, reverse_geocode)
ARCGIS_MCP_URL=https://esri.geospatial.tfc.aws.dev/hosting/platform/mcp
ARCGIS_MCP_TOKEN=your_arcgis_mcp_token

# NASA Earthdata bearer token (https://urs.earthdata.nasa.gov → Generate Token).
# Required to download EMIT plume GeoTIFFs from LP DAAC. Expires after 60 days: refresh it
# the week before any show. Sent only to data.lpdaac.earthdatacloud.nasa.gov, never logged.
EARTHDATA_TOKEN=your_earthdata_bearer_token

# Optional
DISABLE_ADOT_OBSERVABILITY=true
