# Copy to .env.dev (DEPLOY_TARGET=dev) or .env (stable). Both are gitignored.
S3_BUCKET_NAME=your-project-bucket
AGENTCORE_ARN=arn:aws:iam::YOUR_ACCOUNT_ID:role/agentcore-geospatial-agent-on-aws-role
AWS_REGION=us-east-1
MODEL_ID=us.anthropic.claude-sonnet-4-6
DISABLE_ADOT_OBSERVABILITY=true

# Builder only (scripts/build_vessel_cache.py, list_vessel_passes.py, build_vessel_records.py).
# Never deployed: deploy.sh does not pass it, and the runtime never calls Global Fishing Watch.
GFW_API_TOKEN=
