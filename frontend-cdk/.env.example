# AWS Configuration
AWS_REGION=us-east-1

# Bedrock AgentCore Runtime ARN (Required)
# Get this from your deployed Python AgentCore agent
AGENT_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-east-1:YOUR_ACCOUNT_ID:runtime/YOUR_AGENT_ID

# S3 Bucket Name (Required)
# Same bucket created in Part 1
S3_BUCKET_NAME=geospatial-agent-on-aws-YOUR_ACCOUNT_ID

# Admin Email (Required)
# Email for the initial admin user - will receive temporary password
ADMIN_EMAIL=your-email@example.com

# Optional: Stack customization
# STACK_NAME=GeospatialAgentStack
# ENVIRONMENT=dev
# Optional: extra AgentCore runtimes for the UI agent switcher (JSON keyed by agentId).
# Passed to the backend as AGENT_RUNTIMES; every ARN listed is granted to the ECS task role.
# Order matters: the entry named "default", else the FIRST entry, is the runtime a fresh browser
# lands on. Put the live/stable runtime first. Quote the JSON in single quotes so `source .env` keeps it intact.
# AGENT_RUNTIMES={"default":{"arn":"arn:aws:bedrock-agentcore:us-east-1:YOUR_ACCOUNT_ID:runtime/STABLE_ID","label":"Earth Analyst","description":"Sentinel-2 analysis, change detection, protected areas"},"dev":{"arn":"arn:aws:bedrock-agentcore:us-east-1:YOUR_ACCOUNT_ID:runtime/DEV_ID","label":"Earth Analyst (dev)","description":"Development runtime"}}

# TiTiler tile server (Required for imagery on the map). The frontend is a static build inside
# the container image, so these are passed as Docker build args by the stack. They are the ONLY
# way production build values reach the bundle: react-ui/frontend/.env is dev-only and is
# excluded from the build context. The API key is a browser-side rate-limiting key (sent as
# x-api-key from the page), not a confidential secret.
VITE_TITILER_URL=https://your-api-gateway-url.execute-api.us-east-1.amazonaws.com/prod/
VITE_TITILER_API_KEY=your_titiler_api_key
